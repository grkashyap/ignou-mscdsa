    <dashboard name='Executive Summary' type='storyboard'>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='396' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3423' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone fixed-size='79' h='6535' id='4' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4253' />
            <zone h='88382' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='10788'>
              <flipboard active-id='3' nav-type='dot' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='1. Executive Overview: Overall Sales Performance Across Regions' captured-sheet='Sales By Region' id='1' />
                  <story-point caption='2. Category Performance: Technology Leads Revenue' captured-sheet='Category-Subcategory' id='2' />
                  <story-point caption='3. Profitability Analysis: Identifying Low-Margin Categories' captured-sheet='Profitability' id='3' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' h='20332' hidden='true' id='6' story-point-id='1' type-v2='text' w='16535' x='83071' y='24585'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='-apple-system,system-ui,sans-serif'>Sales have grown consistently year-over-year, with the West and East regions generating over 60% of total revenue.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='25726' hidden='true' id='7' story-point-id='2' type-v2='text' w='16339' x='83071' y='36307'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='-apple-system,system-ui,sans-serif'>Technology products (specifically Laptops and Smartphones) are our top revenue drivers, while Office Supplies drive high order volumes.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='13071' id='8' story-point-id='3' type-v2='text' w='52264' x='17520' y='54876'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='-apple-system,system-ui,sans-serif'>Despite high sales volume in Furniture, certain Sub-Categories (e.g., Tables/Furnishings) exhibit slim or negative profit margins due to high discount rates.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{75A3D371-792A-4751-A56D-416AEC6A0002}' />
    </dashboard>
  </dashboards>
