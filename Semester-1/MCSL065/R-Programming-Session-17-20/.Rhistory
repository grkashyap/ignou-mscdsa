product_data <- read.csv(file = "PRODUCT.csv")
View(product_data)
ggplot(product_data, aes(x=Month, y=Total_Sales_USD)) + geom_line()
ggplot(product_data, aes(x=Month, y=Total_Sales_USD, colour = Product_Name, group = Product_Name)) + geom_line()
View(product_data)
ggplot(product_data, aes(x=Month, y=Total_Sales_USD, colour = Category, group = Category)) + geom_line() + labs(title = "Monthly sales by Category", x="Month", y="Total Sales")
View(product_data)
ggplot(product_data, aes(x=Net_Profit_USD, y=Units_Sold)) + geom_smooth(method = "lm")
ggplot(product_data, aes(x=Net_Profit_USD, y=Units_Sold)) + geom_point(color = "blue") + geom_smooth(method = "lm")
ggplot(product_data, aes(x=Units_Sold, y=Net_Profit_USD)) + geom_point(color = "blue") + geom_smooth(method = "lm") + labs(title = "Scatter Plot - Sales vs Profit", x="Total Sales", y="Profit in USD")
set.seed(101)
sim_data <- data.frame(Value = rnorm(1000, mean = 50, sd = 10))
geom_histogram(aes(y = after_stat(density)), bins = 30, fill = "gray80", color = "gray40", alpha = 0.7) +
# 2. Overlay Fitted Normal Distribution (Theoretical Density Curve)
stat_function(
fun = dnorm,
args = list(mean = mean(sim_data$Value), sd = sd(sim_data$Value)),
aes(color = "Normal Curve"),
linewidth = 1.2
) +
# 3. Overlay Empirical Density Line
geom_density(aes(color = "Empirical Density"), linewidth = 1, linetype = "dashed") +
scale_color_manual(name = "Distribution Lines", values = c("Normal Curve" = "blue", "Empirical Density" = "red")) +
labs(
title = "Histogram and Probability Density Curves",
subtitle = "Comparison of sample density against theoretical normal curve",
x = "Value",
y = "Density"
) +
theme_classic()
